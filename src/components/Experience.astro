---
import data from '../data/portfolio.json';

const { experience } = data;
---

<section class="experience" id="experience">
  <div class="container">
    <div class="sec-head">
      <h2>Experience</h2>
      <span class="sec-meta">2021 — now</span>
    </div>

    <div class="xp">
      <span class="xp__line" aria-hidden="true"></span>
      {experience.map((job) => (
        <div class="xp__item reveal">
          <span class="xp__when">{job.dates}</span>
          <h3 class="xp__role">{job.role}</h3>
          <span class="xp__co">{job.company} · {job.location}</span>
          <ul class="xp__bullets">
            {job.bullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
          <div class="chips xp__chips">
            {job.tech.map((t) => (
              <span class="chip">{t}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .xp {
    position: relative;
    border-left: 1px solid var(--line);
    margin-left: 6px;
  }

  .xp__line {
    position: absolute;
    left: -1px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--accent);
    transform-origin: top;
  }

  .xp__item {
    position: relative;
    padding: 0 0 44px 34px;
  }

  .xp__item::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 8px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  .xp__when {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-2);
    text-transform: uppercase;
  }

  .xp__role {
    font-size: 1.1rem;
    font-weight: 720;
    margin: 6px 0 2px;
    letter-spacing: -0.01em;
  }

  .xp__co {
    font-size: 0.85rem;
    color: var(--accent);
    font-weight: 600;
  }

  .xp__bullets {
    margin-top: 12px;
  }

  .xp__bullets li {
    padding: 4px 0 4px 24px;
    position: relative;
    font-size: 0.89rem;
    color: var(--ink-2);
    max-width: 68ch;
  }

  .xp__bullets li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
  }

  .xp__chips {
    margin-top: 12px;
  }
</style>
