---
import data from '../data/portfolio.json';
import ProjectCard from './ProjectCard.astro';

const { projects } = data;
---

<section class="projects" id="work">
  <div class="container">
    <div class="sec-head reveal">
      <h2>Selected work</h2>
      <span class="sec-meta">{String(projects.length).padStart(2, '0')} projects</span>
    </div>

    <div class="projects__grid">
      {projects.map((project, i) => (
        <div class="reveal" style={`transition-delay: ${i * 0.06}s`}>
          <ProjectCard
            id={project.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}
            name={project.name}
            category={project.category}
            tagline={project.tagline}
            description={project.description}
            highlights={project.highlights}
            tech={project.tech}
            github={'github' in project ? project.github : undefined}
            url={'url' in project ? project.url : undefined}
            visual={project.visual}
          />
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-modal]').forEach((card) => {
    const dialog = document.getElementById(card.dataset.modal!) as HTMLDialogElement | null;
    if (!dialog) return;
    card.addEventListener('click', () => dialog.showModal());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.querySelectorAll('[data-close]').forEach((btn) =>
      btn.addEventListener('click', () => dialog.close())
    );
  });
</script>

<style>
  .projects__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
  }

  .projects__grid > div {
    height: 100%;
  }
</style>
