---
import data from '../data/portfolio.json';

const { skills } = data;

const groups = [
  { label: 'Security', items: skills.security_tools },
  { label: 'Frameworks & standards', items: skills.security_frameworks },
  { label: 'Engineering', items: [...skills.languages.slice(0, 5), ...skills.frameworks.slice(0, 3), 'Azure'] },
];
---

<section class="skills" id="skills">
  <div class="container">
    <div class="sec-head reveal">
      <h2>Toolbox</h2>
    </div>

    <div class="skills__grid">
      {groups.map((group, i) => (
        <div class="reveal" style={`transition-delay: ${i * 0.06}s`}>
          <h3 class="skills__label">{group.label}</h3>
          <div class="chips">
            {group.items.map((item) => (
              <span class="chip">{item}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 34px;
  }

  .skills__label {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin-bottom: 14px;
  }
</style>
