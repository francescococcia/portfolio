---
import data from '../data/portfolio.json';

const { skills } = data;

const groups = [
  {
    label: 'Security Tools',
    key: 'security_tools',
    items: skills.security_tools,
    color: 'green',
  },
  {
    label: 'Security Frameworks',
    key: 'security_frameworks',
    items: skills.security_frameworks,
    color: 'purple',
  },
  {
    label: 'Languages',
    key: 'languages',
    items: skills.languages,
    color: 'green',
  },
  {
    label: 'Frameworks & Cloud',
    key: 'frameworks_cloud',
    items: [...skills.frameworks, ...skills.cloud],
    color: 'purple',
  },
];
---

<section class="skills" id="skills">
  <div class="container">
    <p class="section-label reveal">// skills</p>
    <h2 class="section-title reveal">Technical Arsenal</h2>

    <div class="skills__grid">
      {groups.map((group, gi) => (
        <div class={`skills__group reveal`} style={`transition-delay: ${gi * 0.1}s`}>
          <div class="skills__group-header">
            <span class={`skills__group-dot skills__group-dot--${group.color}`} aria-hidden="true"></span>
            <h3 class="skills__group-title">{group.label}</h3>
          </div>
          <div class="skills__badges">
            {group.items.map((item) => (
              <span class={`badge badge--${group.color}`}>{item}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .skills__group {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 1.75rem;
    transition: border-color 0.25s ease;
  }

  .skills__group:hover {
    border-color: rgba(0, 255, 157, 0.25);
  }

  .skills__group-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
  }

  .skills__group-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .skills__group-dot--green {
    background: var(--accent-green);
    box-shadow: 0 0 6px rgba(0, 255, 157, 0.6);
  }

  .skills__group-dot--purple {
    background: var(--accent-purple);
    box-shadow: 0 0 6px rgba(123, 97, 255, 0.6);
  }

  .skills__group-title {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .skills__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .badge--purple {
    color: var(--accent-purple);
    border-color: rgba(123, 97, 255, 0.35);
  }

  .badge--purple:hover {
    border-color: var(--accent-purple);
    background: rgba(123, 97, 255, 0.06);
  }

  @media (max-width: 768px) {
    .skills__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
