---
import data from '../data/portfolio.json';

const { personal } = data;

const facts = [
  { value: '4 years', label: 'enterprise engineering' },
  { value: '~90%', label: 'injection surface removed' },
  { value: 'NCSC MSc', label: 'Univ. of Greenwich' },
  { value: '500+', label: 'clients served' },
];
---

<header class="hero" id="top">
  <div class="container">
    <p class="hero__kicker" data-anim style="--i: 0">{personal.title.split('|')[0].trim()} — {personal.location}</p>
    <h1 class="hero__headline" data-anim style="--i: 1">
      Security you can <span class="hero__dim">actually ship.</span>
    </h1>
    <p class="hero__pitch" data-anim style="--i: 2">
      I'm {personal.name} — penetration tester and secure software engineer with four years of
      enterprise production scars. Currently completing an NCSC-certified MSc in Computer Forensics
      &amp; Cyber Security. I think like an attacker and build like an engineer.
    </p>
    <div class="hero__ctas" data-anim style="--i: 3">
      <a href="#work" class="btn btn-fill">See my work</a>
      <a href="#contact" class="btn btn-line">Get in touch</a>
    </div>
    <div class="hero__facts" data-anim style="--i: 4">
      {facts.map((fact) => (
        <div class="hero__fact">
          <b>{fact.value}</b>
          <span>{fact.label}</span>
        </div>
      ))}
    </div>
  </div>
</header>

<style>
  .hero {
    min-height: 92vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 90px;
  }

  .hero__kicker {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
  }

  .hero__headline {
    font-size: clamp(2.8rem, 7.5vw, 5.4rem);
    font-weight: 750;
    line-height: 1.02;
    letter-spacing: -0.03em;
    margin: 18px 0 22px;
  }

  .hero__dim {
    color: var(--ink-2);
  }

  .hero__pitch {
    max-width: 58ch;
    color: var(--ink-2);
    font-size: 1.06rem;
  }

  .hero__ctas {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 34px;
  }

  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    margin-top: 56px;
    border-top: 1px solid var(--line);
  }

  .hero__fact {
    padding: 18px 28px 0 0;
    margin-right: 28px;
  }

  .hero__fact b {
    display: block;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .hero__fact span {
    font-size: 0.78rem;
    color: var(--ink-2);
  }
</style>
