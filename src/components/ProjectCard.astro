---
interface Props {
  id: string;
  name: string;
  category: string;
  tagline: string;
  description: string;
  highlights: string[];
  tech: string[];
  github?: string;
  url?: string;
  visual: string;
}

const { id, name, category, tagline, description, highlights, tech, github, url, visual } =
  Astro.props;
---

<button class="pcard" data-modal={`modal-${id}`} type="button">
  <div class="pcard__viz" aria-hidden="true">
    {visual === 'extension' && (
      <svg viewBox="0 0 240 100">
        <rect x="12" y="10" width="150" height="80" rx="7" fill="none" stroke="var(--ink-2)" stroke-width="1.4" opacity=".55" />
        <line x1="12" y1="26" x2="162" y2="26" stroke="var(--ink-2)" stroke-width="1.2" opacity=".45" />
        <circle cx="22" cy="18" r="2.4" fill="var(--ink-2)" opacity=".5" />
        <circle cx="31" cy="18" r="2.4" fill="var(--ink-2)" opacity=".5" />
        <rect x="24" y="38" width="86" height="7" rx="3.5" fill="var(--ink-2)" opacity=".3" />
        <rect x="24" y="52" width="112" height="7" rx="3.5" fill="var(--ink-2)" opacity=".2" />
        <rect x="24" y="66" width="64" height="7" rx="3.5" fill="var(--ink-2)" opacity=".25" />
        <circle cx="192" cy="50" r="26" fill="none" stroke="var(--accent)" stroke-width="2.4" />
        <text x="192" y="55" text-anchor="middle" font-size="13" font-weight="700" fill="var(--accent)">87%</text>
      </svg>
    )}
    {visual === 'terminal' && (
      <svg viewBox="0 0 240 100">
        <rect x="18" y="14" width="204" height="72" rx="7" fill="none" stroke="var(--ink-2)" stroke-width="1.4" opacity=".5" />
        <text x="30" y="38" font-family="monospace" font-size="10" fill="var(--ink-2)" opacity=".7">$ nmap -sV 10.0.4.12</text>
        <text x="30" y="56" font-family="monospace" font-size="10" fill="var(--ink-2)" opacity=".5">22/tcp open ssh · 443/tcp open https</text>
        <rect x="30" y="64" width="92" height="12" rx="6" fill="var(--accent)" opacity=".15" />
        <text x="36" y="73.5" font-family="monospace" font-size="9" font-weight="700" fill="var(--accent)">CVSS 8.6 — HIGH</text>
      </svg>
    )}
    {visual === 'rank' && (
      <svg viewBox="0 0 240 100">
        <path d="M30 78 L70 55 L110 66 L150 34 L190 42 L214 22" fill="none" stroke="var(--accent)" stroke-width="2.4" stroke-linecap="round" />
        <circle cx="150" cy="34" r="4.5" fill="var(--accent)" />
        <circle cx="214" cy="22" r="4.5" fill="var(--accent)" />
        <line x1="30" y1="86" x2="214" y2="86" stroke="var(--ink-2)" stroke-width="1.2" opacity=".4" />
        <text x="30" y="24" font-family="monospace" font-size="10" fill="var(--ink-2)" opacity=".7">rank ↗</text>
      </svg>
    )}
  </div>
  <div class="pcard__body">
    <span class="pcard__cat">{category}</span>
    <h3 class="pcard__name">{name}</h3>
    <p class="pcard__tagline">{tagline}</p>
    <span class="pcard__open">Case study</span>
  </div>
</button>

<dialog class="pmodal" id={`modal-${id}`}>
  <div class="pmodal__head">
    <div>
      <span class="pcard__cat">{category}</span>
      <h3 class="pmodal__title">{name}</h3>
    </div>
    <button class="pmodal__close" data-close aria-label="Close">✕</button>
  </div>
  <div class="pmodal__body">
    <p class="pmodal__desc">{description}</p>
    <h4 class="pmodal__label">Highlights</h4>
    <ul class="pmodal__list">
      {highlights.map((h) => (
        <li>{h}</li>
      ))}
    </ul>
    <h4 class="pmodal__label">Stack</h4>
    <div class="chips">
      {tech.map((t) => (
        <span class="chip">{t}</span>
      ))}
    </div>
    <div class="pmodal__actions">
      {github && (
        <a class="btn btn-fill" href={`https://${github}`} target="_blank" rel="noopener noreferrer">
          View on GitHub
        </a>
      )}
      {url && (
        <a class="btn btn-fill" href={`https://${url}`} target="_blank" rel="noopener noreferrer">
          View profile
        </a>
      )}
      <button class="btn btn-line" data-close type="button">Close</button>
    </div>
  </div>
</dialog>

<style>
  .pcard {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-align: left;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    transition: transform var(--dur-ui) var(--ease-out), box-shadow var(--dur-ui) ease,
      border-color var(--dur-ui) ease;
  }

  .pcard:hover,
  .pcard:focus-visible {
    transform: translateY(-5px);
    box-shadow: var(--shadow);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
  }

  .pcard:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .pcard__viz {
    height: 150px;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    display: grid;
    place-items: center;
  }

  .pcard__viz svg {
    width: 82%;
    height: 78%;
  }

  .pcard__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 20px 22px 22px;
  }

  .pcard__cat {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--accent);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .pcard__name {
    font-size: 1.08rem;
    font-weight: 700;
    margin: 7px 0 6px;
    letter-spacing: -0.01em;
  }

  .pcard__tagline {
    font-size: 0.87rem;
    color: var(--ink-2);
    flex: 1;
  }

  .pcard__open {
    display: inline-block;
    margin-top: 14px;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent);
  }

  .pcard__open::after {
    content: ' →';
    transition: margin var(--dur-micro) ease;
  }

  .pcard:hover .pcard__open::after {
    margin-left: 4px;
  }

  /* modal */
  .pmodal {
    margin: auto;
    border: none;
    border-radius: 20px;
    padding: 0;
    max-width: 620px;
    width: calc(100% - 40px);
    max-height: calc(100vh - 48px);
    background: var(--bg);
    color: var(--ink);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
  }

  .pmodal::backdrop {
    background: rgba(10, 11, 14, 0.55);
    backdrop-filter: blur(3px);
  }

  .pmodal__head {
    padding: 26px 30px 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
  }

  .pmodal__title {
    font-size: 1.5rem;
    font-weight: 740;
    letter-spacing: -0.02em;
    margin-top: 6px;
  }

  .pmodal__close {
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink-2);
    width: 34px;
    height: 34px;
    border-radius: 50%;
    font-size: 0.9rem;
    flex-shrink: 0;
  }

  .pmodal__close:hover {
    color: var(--ink);
  }

  .pmodal__body {
    padding: 16px 30px 30px;
  }

  .pmodal__desc {
    color: var(--ink-2);
    font-size: 0.93rem;
  }

  .pmodal__label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin: 22px 0 10px;
  }

  .pmodal__list li {
    padding: 5px 0 5px 26px;
    position: relative;
    font-size: 0.9rem;
  }

  .pmodal__list li::before {
    content: '✓';
    position: absolute;
    left: 2px;
    color: var(--accent);
    font-weight: 700;
  }

  .pmodal__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 26px;
  }
</style>
