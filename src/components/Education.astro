---
import data from '../data/portfolio.json';

const { education, certifications } = data;
---

<section class="education" id="education">
  <div class="container">
    <div class="sec-head reveal">
      <h2>Education &amp; certifications</h2>
    </div>

    <div class="edu">
      {education.map((edu, i) => (
        <div class="edu__row reveal" style={`transition-delay: ${i * 0.06}s`}>
          <span class="edu__when">{edu.year}</span>
          <div>
            <b class="edu__degree">{edu.degree}</b>
            <span class="edu__inst">{edu.institution}</span>
            {edu.notes && <span class="edu__notes">{edu.notes}</span>}
          </div>
        </div>
      ))}
      {certifications.map((cert) => (
        <div class="edu__row reveal">
          <span class="edu__when">CERT</span>
          <div>
            <b class="edu__degree">{cert}</b>
          </div>
        </div>
      ))}
      <div class="edu__row reveal">
        <span class="edu__when">NEXT</span>
        <div>
          <b class="edu__degree edu__degree--muted">CompTIA Security+ (target 2026) · eJPT/PNPT — in progress</b>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .edu__row {
    display: flex;
    align-items: baseline;
    gap: 26px;
    padding: 20px 4px;
    border-bottom: 1px solid var(--line);
    transition: background var(--dur-micro) ease, padding var(--dur-ui) var(--ease-out);
  }

  .edu__row:first-child {
    border-top: 1px solid var(--line);
  }

  .edu__row:hover {
    background: var(--surface);
    padding-left: 14px;
  }

  .edu__when {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--ink-2);
    min-width: 110px;
    text-transform: uppercase;
  }

  .edu__degree {
    display: block;
    font-weight: 700;
    font-size: 0.98rem;
    letter-spacing: -0.01em;
  }

  .edu__degree--muted {
    color: var(--ink-2);
    font-weight: 600;
  }

  .edu__inst {
    display: block;
    font-size: 0.85rem;
    color: var(--accent);
    font-weight: 600;
    margin-top: 2px;
  }

  .edu__notes {
    display: block;
    font-size: 0.8rem;
    color: var(--ink-2);
    margin-top: 2px;
  }

  @media (max-width: 600px) {
    .edu__row {
      flex-direction: column;
      gap: 4px;
    }

    .edu__when {
      min-width: 0;
    }
  }
</style>
