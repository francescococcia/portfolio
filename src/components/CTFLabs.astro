---
const platforms = [
  {
    name: 'TryHackMe',
    handle: 'francescococcia',
    url: 'https://tryhackme.com/p/francescococcia',
    color: '#ff3e3e',
    description: 'Actively completing offensive security learning paths — web exploitation, privilege escalation, network attacks, and Linux enumeration.',
    icon: `<svg width="28" height="28" viewBox="0 0 50 50" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="25" cy="25" r="24" stroke="#ff3e3e" stroke-width="2"/>
      <text x="50%" y="55%" dominant-baseline="middle" text-anchor="middle" fill="#ff3e3e" font-family="monospace" font-size="11" font-weight="bold">THM</text>
    </svg>`,
  },
  {
    name: 'HackTheBox',
    handle: 'Active CTF player',
    url: 'https://hackthebox.com',
    color: '#9fef00',
    description: 'Regular HackTheBox competitor tackling realistic machine compromises — from initial foothold to root — and pro lab environments.',
    icon: `<svg width="28" height="28" viewBox="0 0 50 50" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="25" cy="25" r="24" stroke="#9fef00" stroke-width="2"/>
      <text x="50%" y="55%" dominant-baseline="middle" text-anchor="middle" fill="#9fef00" font-family="monospace" font-size="11" font-weight="bold">HTB</text>
    </svg>`,
  },
];

const focus_areas = [
  'Web Application Exploitation',
  'Privilege Escalation (Linux/Windows)',
  'Network Enumeration & Attacks',
  'Buffer Overflow & Binary Exploitation',
  'Active Directory Attacks',
  'OSINT & Reconnaissance',
];
---

<section class="ctf" id="ctf">
  <div class="container">
    <p class="section-label reveal">// ctf & labs</p>
    <h2 class="section-title reveal">Offensive Security Practice</h2>

    <div class="ctf__layout">
      <div class="ctf__intro reveal">
        <p class="ctf__intro-text">
          Beyond the classroom, I stay sharp through continuous hands-on offensive security practice.
          CTF competitions and lab environments are where theory meets execution — every box
          rooted and every flag captured builds pattern recognition that carries into real engagements.
        </p>

        <div class="ctf__focus">
          <h3 class="ctf__focus-title">Active Focus Areas</h3>
          <ul class="ctf__focus-list">
            {focus_areas.map((area) => (
              <li class="ctf__focus-item">
                <span class="ctf__focus-bullet" aria-hidden="true">▸</span>
                {area}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="ctf__platforms">
        {platforms.map((p, i) => (
          <a
            href={p.url}
            target="_blank"
            rel="noopener noreferrer"
            class="ctf__platform card reveal"
            style={`transition-delay: ${i * 0.15}s; --platform-color: ${p.color}`}
          >
            <div class="ctf__platform-header">
              <Fragment set:html={p.icon} />
              <div class="ctf__platform-info">
                <span class="ctf__platform-name">{p.name}</span>
                <span class="ctf__platform-handle">{p.handle}</span>
              </div>
              <svg class="ctf__platform-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
            </div>
            <p class="ctf__platform-desc">{p.description}</p>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .ctf__layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .ctf__intro-text {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.8;
    margin-bottom: 2rem;
  }

  .ctf__focus-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .ctf__focus-list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .ctf__focus-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.875rem;
    color: var(--text-primary);
    font-family: var(--font-mono);
  }

  .ctf__focus-bullet {
    color: var(--accent-green);
    font-size: 0.7rem;
  }

  .ctf__platforms {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .ctf__platform {
    display: block;
    transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.2s ease;
  }

  .ctf__platform:hover {
    border-color: var(--platform-color);
    box-shadow: 0 0 24px color-mix(in srgb, var(--platform-color) 15%, transparent);
    transform: translateY(-2px);
  }

  .ctf__platform-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .ctf__platform-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .ctf__platform-name {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .ctf__platform-handle {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-green);
  }

  .ctf__platform-arrow {
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .ctf__platform-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.65;
  }

  @media (max-width: 768px) {
    .ctf__layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
