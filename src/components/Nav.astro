---
const links = [
  { href: '#work', label: 'Work' },
  { href: '#experience', label: 'Experience' },
  { href: '#hackathons', label: 'Hackathons' },
  { href: '#education', label: 'Education' },
  { href: '#contact', label: 'Contact' },
];
---

<nav class="nav" id="nav">
  <a href="#top" class="nav__id">Francesco<span class="nav__dot">.</span></a>

  <ul class="nav__links" id="navLinks">
    {links.map((link) => (
      <li>
        <a href={link.href} class="nav__link">{link.label}</a>
      </li>
    ))}
  </ul>

  <button class="nav__theme" id="themeToggle" aria-label="Toggle color theme">◐</button>

  <button class="nav__burger" id="navToggle" aria-label="Toggle navigation" aria-expanded="false">
    <span></span>
    <span></span>
  </button>
</nav>

<div class="nav__sheet" id="navSheet">
  {links.map((link) => (
    <a href={link.href} class="nav__sheet-link">{link.label}</a>
  ))}
</div>

<script>
  const toggle = document.getElementById('themeToggle')!;
  toggle.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    if (next === 'dark') root.dataset.theme = 'dark';
    else delete root.dataset.theme;
    localStorage.setItem('theme', next);
  });

  const nav = document.getElementById('nav')!;
  addEventListener('scroll', () => {
    nav.classList.toggle('nav--scrolled', scrollY > 40);
  }, { passive: true });

  const burger = document.getElementById('navToggle')!;
  const sheet = document.getElementById('navSheet')!;
  const close = () => {
    sheet.classList.remove('nav__sheet--open');
    burger.classList.remove('nav__burger--open');
    burger.setAttribute('aria-expanded', 'false');
  };
  burger.addEventListener('click', () => {
    const open = sheet.classList.toggle('nav__sheet--open');
    burger.classList.toggle('nav__burger--open', open);
    burger.setAttribute('aria-expanded', String(open));
  });
  sheet.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
</script>

<style>
  .nav {
    position: fixed;
    top: 18px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 100;
    display: flex;
    align-items: center;
    gap: 4px;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 6px 8px 6px 16px;
    box-shadow: var(--shadow);
    max-width: calc(100vw - 32px);
    transition: transform var(--dur-ui) var(--ease-out), box-shadow var(--dur-ui) ease;
  }

  .nav--scrolled {
    transform: translateX(-50%) scale(0.94);
    box-shadow: 0 18px 50px rgba(22, 24, 29, 0.16);
  }

  .nav__id {
    font-weight: 700;
    font-size: 0.88rem;
    letter-spacing: -0.01em;
    margin-right: 10px;
    white-space: nowrap;
  }

  .nav__dot {
    color: var(--accent);
  }

  .nav__links {
    display: flex;
    align-items: center;
  }

  .nav__link {
    display: inline-block;
    color: var(--ink-2);
    font-size: 0.8rem;
    padding: 6px 11px;
    border-radius: 999px;
    transition: color var(--dur-micro) ease, background var(--dur-micro) ease;
  }

  .nav__link:hover {
    color: var(--ink);
    background: var(--surface);
  }

  .nav__theme {
    border: 1px solid var(--line);
    background: var(--surface);
    width: 32px;
    height: 32px;
    border-radius: 50%;
    font-size: 0.8rem;
    margin-left: 6px;
    flex-shrink: 0;
    transition: transform var(--dur-ui) var(--ease-out);
  }

  .nav__theme:hover {
    transform: rotate(24deg);
  }

  .nav__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    border: 1px solid var(--line);
    background: var(--surface);
    border-radius: 50%;
    margin-left: 6px;
    flex-shrink: 0;
  }

  .nav__burger span {
    display: block;
    width: 14px;
    height: 1.5px;
    margin: 0 auto;
    background: var(--ink);
    transition: transform var(--dur-ui) var(--ease-out);
    transform-origin: center;
  }

  .nav__burger--open span:nth-child(1) {
    transform: translateY(3.25px) rotate(45deg);
  }

  .nav__burger--open span:nth-child(2) {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  .nav__sheet {
    position: fixed;
    top: 72px;
    left: 16px;
    right: 16px;
    z-index: 99;
    display: flex;
    flex-direction: column;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 10px;
    box-shadow: var(--shadow);
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    transition: opacity var(--dur-ui) var(--ease-out), transform var(--dur-ui) var(--ease-out);
  }

  .nav__sheet--open {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .nav__sheet-link {
    padding: 12px 16px;
    border-radius: 12px;
    font-size: 0.95rem;
    color: var(--ink);
  }

  .nav__sheet-link:hover {
    background: var(--surface);
  }

  @media (max-width: 760px) {
    .nav__links {
      display: none;
    }

    .nav__burger {
      display: flex;
    }
  }

  @media (min-width: 761px) {
    .nav__sheet {
      display: none;
    }
  }
</style>
