---
import data from '../data/portfolio.json';

const { personal } = data;

const links = [
  {
    label: 'Email',
    value: personal.email,
    href: `mailto:${personal.email}`,
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`,
  },
  {
    label: 'LinkedIn',
    value: personal.linkedin,
    href: `https://${personal.linkedin}`,
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
  {
    label: 'GitHub',
    value: personal.github,
    href: `https://${personal.github}`,
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>`,
  },
];
---

<section class="contact" id="contact">
  <div class="container">
    <div class="contact__inner">
      <p class="section-label reveal">// contact</p>
      <h2 class="section-title reveal">Get In Touch</h2>

      <p class="contact__intro reveal">
        Available for cyber security roles, penetration testing engagements, security consulting,
        and collaboration on security research. I respond to every serious inquiry.
      </p>

      <div class="contact__links reveal">
        {links.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith('mailto') ? undefined : '_blank'}
            rel={link.href.startsWith('mailto') ? undefined : 'noopener noreferrer'}
            class="contact__link"
          >
            <span class="contact__link-icon" set:html={link.icon} />
            <span class="contact__link-info">
              <span class="contact__link-label">{link.label}</span>
              <span class="contact__link-value">{link.value}</span>
            </span>
            <svg class="contact__link-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        ))}
      </div>

      <div class="contact__footer reveal">
        <div class="contact__divider" aria-hidden="true"></div>
        <p class="contact__tagline">
          <span class="contact__tagline-prompt">root@kali:~$</span>
          <span class="contact__tagline-text"> echo "Think like an attacker. Build like an engineer."</span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    border-top: 1px solid var(--border);
  }

  .contact__inner {
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
  }

  .contact__inner .section-label,
  .contact__inner .section-title {
    text-align: center;
  }

  .contact__inner .section-title::after {
    margin: 0.75rem auto 0;
  }

  .contact__intro {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.75;
    margin-bottom: 3rem;
  }

  .contact__links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 3rem;
    text-align: left;
  }

  .contact__link {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 6px;
    transition: border-color 0.25s ease, background 0.25s ease, transform 0.2s ease;
    color: var(--text-primary);
  }

  .contact__link:hover {
    border-color: rgba(0, 255, 157, 0.4);
    background: rgba(0, 255, 157, 0.03);
    transform: translateX(4px);
  }

  .contact__link-icon {
    color: var(--accent-green);
    flex-shrink: 0;
    line-height: 0;
  }

  .contact__link-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .contact__link-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contact__link-value {
    font-size: 0.9rem;
    color: var(--text-primary);
  }

  .contact__link-arrow {
    color: var(--text-muted);
    flex-shrink: 0;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .contact__link:hover .contact__link-arrow {
    color: var(--accent-green);
    transform: translateX(3px);
  }

  .contact__footer {
    padding-top: 2rem;
  }

  .contact__divider {
    width: 100%;
    height: 1px;
    background: var(--border);
    margin-bottom: 2rem;
  }

  .contact__tagline {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .contact__tagline-prompt {
    color: var(--accent-green);
  }

  @media (max-width: 480px) {
    .contact__link-value {
      font-size: 0.78rem;
      word-break: break-all;
    }
  }
</style>
