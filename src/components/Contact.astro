---
import data from '../data/portfolio.json';

const { personal } = data;
---

<section class="contact" id="contact">
  <div class="container">
    <h2 class="contact__headline reveal">
      Let's find the flaw <em>before someone else does.</em>
    </h2>
    <p class="contact__pitch reveal">
      Available for cyber security roles, penetration testing engagements, and collaboration on
      security research. I respond to every serious inquiry.
    </p>
    <div class="contact__ctas reveal">
      <a class="btn btn-fill" href={`mailto:${personal.email}`}>{personal.email}</a>
      <a class="btn btn-line" href={`https://${personal.linkedin}`} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a class="btn btn-line" href={`https://${personal.github}`} target="_blank" rel="noopener noreferrer">GitHub</a>
    </div>

    <div class="contact__foot">
      <span>© 2026 {personal.name} · {personal.location}</span>
      <span>No trackers · no cookies · <b>built lean by design</b></span>
    </div>
  </div>
</section>

<style>
  .contact {
    padding: 120px 0 0;
  }

  .contact__headline {
    font-size: clamp(2rem, 5.4vw, 3.6rem);
    font-weight: 750;
    letter-spacing: -0.03em;
    line-height: 1.06;
    max-width: 20ch;
  }

  .contact__headline em {
    font-style: normal;
    color: var(--accent);
  }

  .contact__pitch {
    color: var(--ink-2);
    margin-top: 18px;
    max-width: 52ch;
  }

  .contact__ctas {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 30px;
  }

  .contact__foot {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    padding: 26px 0 90px;
    border-top: 1px solid var(--line);
    margin-top: 80px;
    color: var(--ink-2);
    font-size: 0.78rem;
  }

  .contact__foot b {
    color: var(--accent);
    font-weight: 600;
  }
</style>
