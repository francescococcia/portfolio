---
import data from '../data/portfolio.json';

const { hackathons } = data;
---

<section class="hackathons" id="hackathons">
  <div class="container">
    <div class="sec-head">
      <h2>Hackathons</h2>
      <span class="sec-meta">{String(hackathons.length).padStart(2, '0')} events</span>
    </div>

    <div class="hk">
      {hackathons.map((h, i) => (
        <div class="hk__row reveal" style={`transition-delay: ${i * 0.06}s`}>
          <span class="hk__date">{h.date}</span>
          <b class="hk__name">{h.name}</b>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hk__row {
    display: flex;
    align-items: baseline;
    gap: 26px;
    padding: 20px 4px;
    border-bottom: 1px solid var(--line);
  }

  .hk__row:first-child {
    border-top: 1px solid var(--line);
  }

  .hk__date {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--ink-2);
    min-width: 110px;
    text-transform: uppercase;
  }

  .hk__name {
    font-weight: 700;
    font-size: 0.98rem;
    letter-spacing: -0.01em;
  }

  @media (max-width: 600px) {
    .hk__row {
      flex-direction: column;
      gap: 4px;
    }

    .hk__date {
      min-width: 0;
    }
  }
</style>
