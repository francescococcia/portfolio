---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Francesco Coccia — Cyber Security Analyst & Penetration Tester",
  description = "Cyber security professional with 4 years of enterprise engineering experience. Specialising in penetration testing, digital forensics, and secure software development. Based in London, UK.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Francesco Coccia',
  jobTitle: 'Cyber Security Analyst',
  url: canonicalURL,
  sameAs: [
    'https://www.linkedin.com/in/coccia-francesco',
    'https://github.com/francescococcia',
    'https://tryhackme.com/p/francescococcia',
  ],
  knowsAbout: [
    'Penetration Testing',
    'Application Security',
    'Digital Forensics',
    'Secure Software Engineering',
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'London',
    addressCountry: 'UK',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Theme before paint: localStorage wins, then system preference -->
    <script is:inline>
      (function () {
        var t = localStorage.getItem('theme');
        if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        if (t === 'dark') document.documentElement.dataset.theme = 'dark';
      })();
    </script>

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Francesco Coccia" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400..750&family=Geist+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body>
    <div class="rails" aria-hidden="true"><i></i><i></i><i></i></div>
    <slot />

    <!-- Motion: GSAP scroll choreography (content is visible by default; JS only enhances) -->
    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      const mm = gsap.matchMedia();
      mm.add('(prefers-reduced-motion: no-preference)', () => {
        // staggered batch reveals for lists/grids marked .reveal
        const items = gsap.utils.toArray<Element>('.reveal');
        gsap.set(items, { autoAlpha: 0, y: 16 });
        ScrollTrigger.batch(items, {
          start: 'top 88%',
          once: true,
          onEnter: (batch) =>
            gsap.to(batch, {
              autoAlpha: 1,
              y: 0,
              duration: 0.55,
              ease: 'power3.out',
              stagger: 0.08,
              overwrite: true,
            }),
        });

        // section title underline draws in
        gsap.utils.toArray<Element>('.sec-head h2').forEach((h) => {
          gsap.fromTo(
            h,
            { '--underline': 0 },
            {
              '--underline': 1,
              duration: 0.6,
              ease: 'power3.out',
              scrollTrigger: { trigger: h, start: 'top 85%', once: true },
            }
          );
        });

        // experience timeline line draws with scroll
        const line = document.querySelector('.xp__line');
        if (line) {
          gsap.fromTo(
            line,
            { scaleY: 0 },
            {
              scaleY: 1,
              ease: 'none',
              scrollTrigger: { trigger: '.xp', start: 'top 75%', end: 'bottom 55%', scrub: 1 },
            }
          );
        }
      });
    </script>
  </body>
</html>
